{
  "name": "agentshive-mcp",
  "version": "0.1.0",
  "description": "MCP server for Agentshive — search and install AI agents directly from Claude Code, Codex, or Cursor",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentshive-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
